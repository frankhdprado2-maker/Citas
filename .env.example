PORT=3000
DATA_DIR=./data/registro
TIME_ZONE=America/Lima
# Ejecuta npm run setup para generar ambas claves localmente.
# En Render configúralas en Environment, sin subir el .env al repositorio.
ADMIN_PASSWORD=
SESSION_SECRET=

# Confirmaciones a ti y al correo obligatorio escrito por ella.
OWNER_EMAIL=tu-correo@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-correo@gmail.com
# Contraseña de aplicación de Google. No uses tu contraseña habitual.
SMTP_PASSWORD=
# El remitente debe pertenecer a la cuenta configurada en SMTP_USER.
EMAIL_FROM=Un plan contigo <tu-correo@gmail.com>
